    "text": "第五"
  },
  {
    "id": 287,
    "start": 844.0,
    "end": 848.0,
    "text": "其實魯家學者早就把中國文化的目標"
  },
  {
    "id": 288,
    "start": 848.0,
    "end": 850.0,
    "text": "與人格理想相連"
  },
  {
    "id": 289,
    "start": 850.0,
    "end": 852.0,
    "text": "印爾建立了君子知道"
  },
  {
    "id": 290,
    "start": 852.0,
    "end": 854.0,
    "text": "成為中國文化的核心內容"
  },
  {
    "id": 291,
