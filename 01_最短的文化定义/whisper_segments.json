  {
    "id": 292,
    "start": 856.0,
    "end": 857.0,
    "text": "互不共存的"
  },
  {
    "id": 293,
    "start": 857.0,
    "end": 859.0,
    "text": "還有佛家的決者理想"
  },
  {
    "id": 294,
    "start": 859.0,
    "end": 861.0,
    "text": "和道家的爭論理想"
  },
  {
    "id": 295,
    "start": 861.0,
    "end": 865.0,
    "text": "共同組成了中國文化的紅大內涵"
  },
  {
    "id": 296,
