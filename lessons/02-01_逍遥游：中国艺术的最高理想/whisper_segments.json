[
  {
    "id": 0,
    "start": 0.0,
    "end": 12.0,
    "text": "中文化是一條溫柔不惜的大江"
  },
  {
    "id": 1,
    "start": 12.0,
    "end": 18.0,
    "text": "而不是江邊的庫藤老樹婚姜"
  },
  {
    "id": 2,
    "start": 18.0,
    "end": 22.0,
    "text": "你好我是宇秋雨"
  },
  {
    "id": 3,
    "start": 22.0,
    "end": 26.0,
    "text": "歡迎收聽秋雨蘇月必須我喝茶"
  },
  {
    "id": 4,
    "start": 30.0,
    "end": 32.0,
    "text": "大家好我是宇秋雨我們繼續講課"
  },
  {
    "id": 5,
    "start": 32.0,
    "end": 36.0,
    "text": "因為上次我講到裝紙哲學裡面的第一關年腳"
  },
  {
    "id": 6,
    "start": 36.0,
    "end": 38.0,
    "text": "誤者非誤"
  },
  {
    "id": 7,
    "start": 38.0,
    "end": 42.0,
    "text": "五個字我估計我們的學員大多數度比較陌生"
  },
  {
    "id": 8,
    "start": 42.0,
    "end": 46.0,
    "text": "聽了我的課希望大家能夠記住"
  },
  {
    "id": 9,
    "start": 46.0,
    "end": 50.0,
    "text": "以誤之的概念來看誤之的話"
  },
  {
    "id": 10,
    "start": 50.0,
    "end": 52.0,
    "text": "我們就不是創造者"
  },
  {
    "id": 11,
    "start": 52.0,
    "end": 57.0,
    "text": "我們就不是獲得大道的人"
  },
  {
    "id": 12,
    "start": 57.0,
    "end": 59.0,
    "text": "所以裝置的意思"
  },
  {
    "id": 13,
    "start": 59.0,
    "end": 61.0,
    "text": "我們不要以誤物關物"
  },
  {
    "id": 14,
    "start": 61.0,
    "end": 64.0,
    "text": "應該以道來關物"
  },
  {
    "id": 15,
    "start": 64.0,
    "end": 66.0,
    "text": "以人來關物"
  },
  {
    "id": 16,
    "start": 66.0,
    "end": 69.0,
    "text": "這個觀念呢"
  },
  {
    "id": 17,
    "start": 69.0,
    "end": 72.0,
    "text": "如果以誤來關物的話"
  },
  {
    "id": 18,
    "start": 72.0,
    "end": 74.0,
    "text": "這個誤我們是飯化的"
  },
  {
    "id": 19,
    "start": 74.0,
    "end": 76.0,
    "text": "我們上次提到"
  },
  {
    "id": 20,
    "start": 76.0,
    "end": 78.0,
    "text": "你有多少財產"
  },
  {
    "id": 21,
    "start": 78.0,
    "end": 79.0,
    "text": "我有多少財產"
  },
  {
    "id": 22,
    "start": 79.0,
    "end": 81.0,
    "text": "你在房子有多大"
  },
  {
    "id": 23,
    "start": 81.0,
    "end": 83.0,
    "text": "我的房子有多大"
  },
  {
    "id": 24,
    "start": 83.0,
    "end": 85.0,
    "text": "你用了什麼牌子的好車"
  },
  {
    "id": 25,
    "start": 85.0,
    "end": 87.0,
    "text": "我用的只是什麼牌子的車"
  },
  {
    "id": 26,
    "start": 87.0,
    "end": 89.0,
    "text": "這比來比去的話"
  },
  {
    "id": 27,
    "start": 89.0,
    "end": 91.0,
    "text": "就是以誤關物"
  },
  {
    "id": 28,
    "start": 91.0,
    "end": 93.0,
    "text": "以誤關物的話"
  },
  {
    "id": 29,
    "start": 93.0,
    "end": 97.0,
    "text": "這個誤一定把創造師入的造物"
  },
  {
    "id": 30,
    "start": 97.0,
    "end": 101.0,
    "text": "准人買到物裡去了"
  },
  {
    "id": 31,
    "start": 101.0,
    "end": 103.0,
    "text": "當時說"
  },
  {
    "id": 32,
    "start": 103.0,
    "end": 106.0,
    "text": "人之所以成為人"
  },
  {
    "id": 33,
    "start": 106.0,
    "end": 107.0,
    "text": "因為他有道"
  },
  {
    "id": 34,
    "start": 107.0,
    "end": 108.0,
    "text": "有有大道"
  },
  {
    "id": 35,
    "start": 108.0,
    "end": 110.0,
    "text": "我們應該以道關物"
  },
  {
    "id": 36,
    "start": 110.0,
    "end": 112.0,
    "text": "以道關物我們就等於"
  },
  {
    "id": 37,
    "start": 112.0,
    "end": 115.0,
    "text": "在山頂上"
  },
  {
    "id": 38,
    "start": 115.0,
    "end": 117.0,
    "text": "來看山腳下的"
  },
  {
    "id": 39,
    "start": 117.0,
    "end": 119.0,
    "text": "各種感的事物了"
  },
  {
    "id": 40,
    "start": 119.0,
    "end": 122.0,
    "text": "你看這個人在為錢才奔毛"
  },
  {
    "id": 41,
    "start": 122.0,
    "end": 124.0,
    "text": "這個人已經找了多少房子"
  },
  {
    "id": 42,
    "start": 124.0,
    "end": 126.0,
    "text": "這個人買了多少車"
  },
  {
    "id": 43,
    "start": 126.0,
    "end": 129.0,
    "text": "在這個人家裡有什麼問題"
  },
  {
    "id": 44,
    "start": 129.0,
    "end": 131.0,
    "text": "他正在奮鬥著"
  },
  {
    "id": 45,
    "start": 131.0,
    "end": 134.0,
    "text": "他自己以為自己快要成為第三名"
  },
  {
    "id": 46,
    "start": 134.0,
    "end": 136.0,
    "text": "其實可能在這個小圈子裡"
  },
  {
    "id": 47,
    "start": 136.0,
    "end": 138.0,
    "text": "他最多也是第三名等等"
  },
  {
    "id": 48,
    "start": 138.0,
    "end": 141.0,
    "text": "這是以道來管他們"
  },
  {
    "id": 49,
    "start": 141.0,
    "end": 144.0,
    "text": "我們很想劝他們不要這麼做"
  },
  {
    "id": 50,
    "start": 144.0,
    "end": 146.0,
    "text": "如果以誤關物的話"
  },
  {
    "id": 51,
    "start": 146.0,
    "end": 148.0,
    "text": "我們就陷進去了"
  },
  {
    "id": 52,
    "start": 148.0,
    "end": 149.0,
    "text": "現在裡面了"
  },
  {
    "id": 53,
    "start": 149.0,
    "end": 151.0,
    "text": "現在裡面的時候"
  },
  {
    "id": 54,
    "start": 151.0,
    "end": 152.0,
    "text": "又想又不對"
  },
  {
    "id": 55,
    "start": 152.0,
    "end": 156.0,
    "text": "我有的時候告訴好多家長了"
  },
  {
    "id": 56,
    "start": 156.0,
    "end": 159.0,
    "text": "你們把自己的孩子說成是"
  },
  {
    "id": 57,
    "start": 159.0,
    "end": 161.0,
    "text": "與文在班記裡邊第五名"
  },
  {
    "id": 58,
    "start": 161.0,
    "end": 163.0,
    "text": "數學在班記裡邊第七名"
  },
  {
    "id": 59,
    "start": 163.0,
    "end": 165.0,
    "text": "這個真的是錯了"
  },
  {
    "id": 60,
    "start": 165.0,
    "end": 166.0,
    "text": "不要這麼排排去"
  },
  {
    "id": 61,
    "start": 166.0,
    "end": 170.0,
    "text": "這個就是以分來管分"
  },
  {
    "id": 62,
    "start": 170.0,
    "end": 172.0,
    "text": "這個搞明了"
  },
  {
    "id": 63,
    "start": 172.0,
    "end": 174.0,
    "text": "你來跳到高處去"
  },
  {
    "id": 64,
    "start": 174.0,
    "end": 177.0,
    "text": "來看你最終喜歡你的兒子"
  },
  {
    "id": 65,
    "start": 177.0,
    "end": 179.0,
    "text": "或者女兒是什麼呢"
  },
  {
    "id": 66,
    "start": 179.0,
    "end": 181.0,
    "text": "我多自講"
  },
  {
    "id": 67,
    "start": 181.0,
    "end": 183.0,
    "text": "我說我對我的學生"
  },
  {
    "id": 68,
    "start": 183.0,
    "end": 185.0,
    "text": "我對年輕人的要求"
  },
  {
    "id": 69,
    "start": 185.0,
    "end": 187.0,
    "text": "往往是六個字"
  },
  {
    "id": 70,
    "start": 187.0,
    "end": 189.0,
    "text": "一個善良"
  },
  {
    "id": 71,
    "start": 189.0,
    "end": 190.0,
    "text": "一個快樂"
  },
  {
    "id": 72,
    "start": 190.0,
    "end": 192.0,
    "text": "一個健康"
  },
  {
    "id": 73,
    "start": 192.0,
    "end": 193.0,
    "text": "沒了"
  },
  {
    "id": 74,
    "start": 193.0,
    "end": 194.0,
    "text": "沒有第七個字了"
  },
  {
    "id": 75,
    "start": 194.0,
    "end": 196.0,
    "text": "這個就是以道來管"
  },
  {
    "id": 76,
    "start": 196.0,
    "end": 198.0,
    "text": "我就你想來想去"
  },
  {
    "id": 77,
    "start": 198.0,
    "end": 201.0,
    "text": "你想到最後在你眼前的"
  },
  {
    "id": 78,
    "start": 201.0,
    "end": 202.0,
    "text": "那個年輕人"
  },
  {
    "id": 79,
    "start": 202.0,
    "end": 203.0,
    "text": "應該是什麼樣的人"
  },
  {
    "id": 80,
    "start": 203.0,
    "end": 204.0,
    "text": "才讓你喜歡"
  },
  {
    "id": 81,
    "start": 204.0,
    "end": 205.0,
    "text": "讓大家喜歡"
  },
  {
    "id": 82,
    "start": 205.0,
    "end": 207.0,
    "text": "讓大家結束"
  },
  {
    "id": 83,
    "start": 207.0,
    "end": 209.0,
    "text": "如果你現在分數"
  },
  {
    "id": 84,
    "start": 209.0,
    "end": 213.0,
    "text": "對房子對車子對裡面的話"
  },
  {
    "id": 85,
    "start": 213.0,
    "end": 215.0,
    "text": "那就是裝置說反對的"
  },
  {
    "id": 86,
    "start": 215.0,
    "end": 216.0,
    "text": "以誤關物"
  },
  {
    "id": 87,
    "start": 216.0,
    "end": 218.0,
    "text": "不是以道關物"
  },
  {
    "id": 88,
    "start": 218.0,
    "end": 220.0,
    "text": "我再說一遍叫"
  },
  {
    "id": 89,
    "start": 220.0,
    "end": 221.0,
    "text": "誤誤者非誤"
  },
  {
    "id": 90,
    "start": 221.0,
    "end": 223.0,
    "text": "要創造失誤的人"
  },
  {
    "id": 91,
    "start": 223.0,
    "end": 226.0,
    "text": "本身並不是誤職"
  },
  {
    "id": 92,
    "start": 227.0,
    "end": 229.0,
    "text": "我們本身應該是人"
  },
  {
    "id": 93,
    "start": 229.0,
    "end": 230.0,
    "text": "應該是道"
  },
  {
    "id": 94,
    "start": 230.0,
    "end": 232.0,
    "text": "這是裝置這個思維"
  },
  {
    "id": 95,
    "start": 232.0,
    "end": 236.0,
    "text": "也是裝置對我們的一種解放"
  },
  {
    "id": 96,
    "start": 236.0,
    "end": 238.0,
    "text": "裝置老想到解放了"
  },
  {
    "id": 97,
    "start": 238.0,
    "end": 240.0,
    "text": "你也在物的"
  },
  {
    "id": 98,
    "start": 240.0,
    "end": 241.0,
    "text": "圈子裡面"
  },
  {
    "id": 99,
    "start": 241.0,
    "end": 243.0,
    "text": "一個人是專不出來的"
  },
  {
    "id": 100,
    "start": 243.0,
    "end": 245.0,
    "text": "當這個物範圍很大了"
  },
  {
    "id": 101,
    "start": 245.0,
    "end": 247.0,
    "text": "我前面已經講到了"
  },
  {
    "id": 102,
    "start": 247.0,
    "end": 249.0,
    "text": "不僅是物之利益了"
  },
  {
    "id": 103,
    "start": 249.0,
    "end": 250.0,
    "text": "還講到名"
  },
  {
    "id": 104,
    "start": 250.0,
    "end": 252.0,
    "text": "名的排位"
  },
  {
    "id": 105,
    "start": 252.0,
    "end": 253.0,
    "text": "還講到全"
  },
  {
    "id": 106,
    "start": 253.0,
    "end": 254.0,
    "text": "但是"
  },
  {
    "id": 107,
    "start": 254.0,
    "end": 256.0,
    "text": "都是於裝置所說的物的範圍"
  },
  {
    "id": 108,
    "start": 256.0,
    "end": 258.0,
    "text": "我們挑開去"
  },
  {
    "id": 109,
    "start": 258.0,
    "end": 260.0,
    "text": "從更高的角度上"
  },
  {
    "id": 110,
    "start": 260.0,
    "end": 263.0,
    "text": "來看到一個世界的創造者"
  },
  {
    "id": 111,
    "start": 263.0,
    "end": 265.0,
    "text": "物者的創造者"
  },
  {
    "id": 112,
    "start": 265.0,
    "end": 268.0,
    "text": "應該是什麼樣的人"
  },
  {
    "id": 113,
    "start": 268.0,
    "end": 269.0,
    "text": "好"
  },
  {
    "id": 114,
    "start": 269.0,
    "end": 271.0,
    "text": "這是裝置的第一句話"
  },
  {
    "id": 115,
    "start": 275.0,
    "end": 277.0,
    "text": "裝置的第二句話"
  },
  {
    "id": 116,
    "start": 277.0,
    "end": 278.0,
    "text": "是三個字"
  },
  {
    "id": 117,
    "start": 278.0,
    "end": 280.0,
    "text": "叫蕭瑤瑤"
  },
  {
    "id": 118,
    "start": 280.0,
    "end": 283.0,
    "text": "是他的一個有名的偏不得題目"
  },
  {
    "id": 119,
    "start": 283.0,
    "end": 284.0,
    "text": "我呢"
  },
  {
    "id": 120,
    "start": 284.0,
    "end": 286.0,
    "text": "曾經"
  },
  {
    "id": 121,
    "start": 286.0,
    "end": 288.0,
    "text": "多好吃的操卸過蕭瑤瑤"
  },
  {
    "id": 122,
    "start": 288.0,
    "end": 290.0,
    "text": "為何操卸呢"
  },
  {
    "id": 123,
    "start": 290.0,
    "end": 292.0,
    "text": "因為他即使我的藝術理想"
  },
  {
    "id": 124,
    "start": 292.0,
    "end": 295.0,
    "text": "也是我的人生理想"
  },
  {
    "id": 125,
    "start": 295.0,
    "end": 298.0,
    "text": "記得我在中央電視台的一次講"
  },
  {
    "id": 126,
    "start": 298.0,
    "end": 300.0,
    "text": "平當中我曾經講過"
  },
  {
    "id": 127,
    "start": 300.0,
    "end": 302.0,
    "text": "蕭瑤瑤有著三個字"
  },
  {
    "id": 128,
    "start": 302.0,
    "end": 304.0,
    "text": "是中國藝術"
  },
  {
    "id": 129,
    "start": 304.0,
    "end": 307.0,
    "text": "和中國人生的最高的理想"
  },
  {
    "id": 130,
    "start": 307.0,
    "end": 309.0,
    "text": "蕭瑤瑤"
  },
  {
    "id": 131,
    "start": 309.0,
    "end": 311.0,
    "text": "這個說法呢"
  },
  {
    "id": 132,
    "start": 311.0,
    "end": 313.0,
    "text": "某一看非常通俗"
  },
  {
    "id": 133,
    "start": 313.0,
    "end": 315.0,
    "text": "我們要蕭瑤自在"
  },
  {
    "id": 134,
    "start": 315.0,
    "end": 320.0,
    "text": "我們要有當在萬里長空當中"
  },
  {
    "id": 135,
    "start": 320.0,
    "end": 324.0,
    "text": "有當在茅茅世界當中"
  },
  {
    "id": 136,
    "start": 324.0,
    "end": 326.0,
    "text": "這樣的話是多麼愉快"
  },
  {
    "id": 137,
    "start": 326.0,
    "end": 328.0,
    "text": "但實際上"
  },
  {
    "id": 138,
    "start": 328.0,
    "end": 330.0,
    "text": "按照裝置的說法"
  },
  {
    "id": 139,
    "start": 330.0,
    "end": 333.0,
    "text": "要真正做到蕭瑤瑤呢"
  },
  {
    "id": 140,
    "start": 334.0,
    "end": 338.0,
    "text": "有兩個無一個角無代"
  },
  {
    "id": 141,
    "start": 338.0,
    "end": 340.0,
    "text": "我們不等待什麼"
  },
  {
    "id": 142,
    "start": 340.0,
    "end": 342.0,
    "text": "第二無幾"
  },
  {
    "id": 143,
    "start": 342.0,
    "end": 345.0,
    "text": "我們自己"
  },
  {
    "id": 144,
    "start": 345.0,
    "end": 347.0,
    "text": "沒有開多了追求"
  },
  {
    "id": 145,
    "start": 347.0,
    "end": 349.0,
    "text": "什麼叫無代呢"
  },
  {
    "id": 146,
    "start": 349.0,
    "end": 351.0,
    "text": "為什麼不等待呢"
  },
  {
    "id": 147,
    "start": 351.0,
    "end": 354.0,
    "text": "就是任何等待"
  },
  {
    "id": 148,
    "start": 354.0,
    "end": 357.0,
    "text": "其實已經蕭瑤一種被動狀態"
  },
  {
    "id": 149,
    "start": 357.0,
    "end": 361.0,
    "text": "已經蕭瑤一種被控制狀態"
  },
  {
    "id": 150,
    "start": 361.0,
    "end": 363.0,
    "text": "譬如"
  },
  {
    "id": 151,
    "start": 363.0,
    "end": 365.0,
    "text": "裝置曾經講過"
  },
  {
    "id": 152,
    "start": 365.0,
    "end": 367.0,
    "text": "有一種大膨"
  },
  {
    "id": 153,
    "start": 367.0,
    "end": 370.0,
    "text": "在九天上飛翔的時候"
  },
  {
    "id": 154,
    "start": 370.0,
    "end": 372.0,
    "text": "憑著大風"
  },
  {
    "id": 155,
    "start": 372.0,
    "end": 374.0,
    "text": "能夠飛行半個月"
  },
  {
    "id": 156,
    "start": 374.0,
    "end": 376.0,
    "text": "這跟人家感到氣泡非常大"
  },
  {
    "id": 157,
    "start": 376.0,
    "end": 378.0,
    "text": "在裝置提出疑問了"
  },
  {
    "id": 158,
    "start": 378.0,
    "end": 382.0,
    "text": "你要靠大風才能飛半個月"
  },
  {
    "id": 159,
    "start": 382.0,
    "end": 385.0,
    "text": "壯觀是雖然壯觀"
  },
  {
    "id": 160,
    "start": 385.0,
    "end": 389.0,
    "text": "但是你已經受到Dennett的舒服了"
  },
  {
    "id": 161,
    "start": 389.0,
    "end": 392.0,
    "text": "沒有風你就飛不了"
  },
  {
    "id": 162,
    "start": 392.0,
    "end": 394.0,
    "text": "風轉向你也都轉向"
  },
  {
    "id": 163,
    "start": 394.0,
    "end": 397.0,
    "text": "風減速你也都減速"
  },
  {
    "id": 164,
    "start": 397.0,
    "end": 400.0,
    "text": "風停息你也都停息"
  },
  {
    "id": 165,
    "start": 400.0,
    "end": 401.0,
    "text": "當然"
  },
  {
    "id": 166,
    "start": 401.0,
    "end": 403.0,
    "text": "從了風之外"
  },
  {
    "id": 167,
    "start": 403.0,
    "end": 406.0,
    "text": "飛翔還要依賴別的很多條件"
  },
  {
    "id": 168,
    "start": 406.0,
    "end": 408.0,
    "text": "譬如地獄、石節等等"
  },
  {
    "id": 169,
    "start": 408.0,
    "end": 409.0,
    "text": "所以"
  },
  {
    "id": 170,
    "start": 409.0,
    "end": 413.0,
    "text": "人們所期待的自由飛翔是什麼呢"
  },
  {
    "id": 171,
    "start": 413.0,
    "end": 415.0,
    "text": "我所說的"
  },
  {
    "id": 172,
    "start": 415.0,
    "end": 419.0,
    "text": "戴習氏就是一個控制的控制"
  },
  {
    "id": 173,
    "start": 419.0,
    "end": 421.0,
    "text": "只要有起過多的期待"
  },
  {
    "id": 174,
    "start": 421.0,
    "end": 424.0,
    "text": "你就有過多的被控制"
  },
  {
    "id": 175,
    "start": 424.0,
    "end": 427.0,
    "text": "結果你也就沒有真正的自由飛翔"
  },
  {
    "id": 176,
    "start": 427.0,
    "end": 429.0,
    "text": "在裝置看起來"
  },
  {
    "id": 177,
    "start": 429.0,
    "end": 431.0,
    "text": "消耀有"
  },
  {
    "id": 178,
    "start": 431.0,
    "end": 435.0,
    "text": "自從內心擺脫一些期待"
  },
  {
    "id": 179,
    "start": 435.0,
    "end": 438.0,
    "text": "擺脫太多的期待和等待"
  },
  {
    "id": 180,
    "start": 438.0,
    "end": 441.0,
    "text": "這個和佛教的思維是一樣的"
  },
  {
    "id": 181,
    "start": 441.0,
    "end": 442.0,
    "text": "我前面講過"
  },
  {
    "id": 182,
    "start": 442.0,
    "end": 443.0,
    "text": "佛教認為"
  },
  {
    "id": 183,
    "start": 443.0,
    "end": 445.0,
    "text": "因為這個東西是空的"
  },
  {
    "id": 184,
    "start": 445.0,
    "end": 447.0,
    "text": "你不能擁抱一個期待"
  },
  {
    "id": 185,
    "start": 447.0,
    "end": 448.0,
    "text": "如果期待的話"
  },
  {
    "id": 186,
    "start": 448.0,
    "end": 452.0,
    "text": "你就變成了一個"
  },
  {
    "id": 187,
    "start": 452.0,
    "end": 455.0,
    "text": "充滿了痛苦的追求者"
  },
  {
    "id": 188,
    "start": 455.0,
    "end": 456.0,
    "text": "這樣的話痛苦"
  },
  {
    "id": 189,
    "start": 456.0,
    "end": 458.0,
    "text": "一直會跟隨在你的背後"
  },
  {
    "id": 190,
    "start": 458.0,
    "end": 462.0,
    "text": "所以我們如果不要期待的話"
  },
  {
    "id": 191,
    "start": 462.0,
    "end": 465.0,
    "text": "不要有太多的依賴的話"
  },
  {
    "id": 192,
    "start": 465.0,
    "end": 467.0,
    "text": "這個戴裡面還包括了"
  },
  {
    "id": 193,
    "start": 467.0,
    "end": 468.0,
    "text": "等待的戴"
  },
  {
    "id": 194,
    "start": 468.0,
    "end": 469.0,
    "text": "包括依賴的意思"
  },
  {
    "id": 195,
    "start": 469.0,
    "end": 471.0,
    "text": "不要有太多的依賴"
  },
  {
    "id": 196,
    "start": 471.0,
    "end": 474.0,
    "text": "甚至說不要有任何更多的依賴的話"
  },
  {
    "id": 197,
    "start": 474.0,
    "end": 476.0,
    "text": "你才能消耀有"
  },
  {
    "id": 198,
    "start": 476.0,
    "end": 478.0,
    "text": "這是一個"
  },
  {
    "id": 199,
    "start": 478.0,
    "end": 480.0,
    "text": "就要無待"
  },
  {
    "id": 200,
    "start": 480.0,
    "end": 481.0,
    "text": "另外無幾"
  },
  {
    "id": 201,
    "start": 481.0,
    "end": 482.0,
    "text": "你不要開自我"
  },
  {
    "id": 202,
    "start": 482.0,
    "end": 484.0,
    "text": "你不要想到自己"
  },
  {
    "id": 203,
    "start": 484.0,
    "end": 485.0,
    "text": "我怎麼樣"
  },
  {
    "id": 204,
    "start": 485.0,
    "end": 486.0,
    "text": "我怎麼樣"
  },
  {
    "id": 205,
    "start": 486.0,
    "end": 488.0,
    "text": "如果這樣想的話"
  },
  {
    "id": 206,
    "start": 488.0,
    "end": 490.0,
    "text": "你也不能消耀"
  },
  {
    "id": 207,
    "start": 490.0,
    "end": 492.0,
    "text": "消耀被一個我日困住了"
  },
  {
    "id": 208,
    "start": 492.0,
    "end": 494.0,
    "text": "被自己的幾日困住了"
  },
  {
    "id": 209,
    "start": 494.0,
    "end": 496.0,
    "text": "你怎麼可以自由呢"
  },
  {
    "id": 210,
    "start": 496.0,
    "end": 498.0,
    "text": "我在天上飛"
  },
  {
    "id": 211,
    "start": 498.0,
    "end": 501.0,
    "text": "其他人要比我快"
  },
  {
    "id": 212,
    "start": 501.0,
    "end": 502.0,
    "text": "或者要比我低"
  },
  {
    "id": 213,
    "start": 502.0,
    "end": 504.0,
    "text": "或者等等等等"
  },
  {
    "id": 214,
    "start": 504.0,
    "end": 507.0,
    "text": "他們更接群"
  },
  {
    "id": 215,
    "start": 507.0,
    "end": 509.0,
    "text": "他們的再速比我多"
  },
  {
    "id": 216,
    "start": 509.0,
    "end": 510.0,
    "text": "等等想了想去"
  },
  {
    "id": 217,
    "start": 510.0,
    "end": 512.0,
    "text": "你整個分享都是不自由的"
  },
  {
    "id": 218,
    "start": 512.0,
    "end": 514.0,
    "text": "你如果"
  },
  {
    "id": 219,
    "start": 514.0,
    "end": 515.0,
    "text": "總預說了"
  },
  {
    "id": 220,
    "start": 515.0,
    "end": 516.0,
    "text": "天上飛的第一名了"
  },
  {
    "id": 221,
    "start": 516.0,
    "end": 518.0,
    "text": "你就會擔憂"
  },
  {
    "id": 222,
    "start": 518.0,
    "end": 520.0,
    "text": "第二名會不會很快趕上我"
  },
  {
    "id": 223,
    "start": 520.0,
    "end": 522.0,
    "text": "又會擔憂第五第六名"
  },
  {
    "id": 224,
    "start": 522.0,
    "end": 525.0,
    "text": "會不會殺容一目鬼祭"
  },
  {
    "id": 225,
    "start": 525.0,
    "end": 526.0,
    "text": "讓我受傷"
  },
  {
    "id": 226,
    "start": 526.0,
    "end": 527.0,
    "text": "等等等等等等"
  },
  {
    "id": 227,
    "start": 527.0,
    "end": 528.0,
    "text": "這樣"
  },
  {
    "id": 228,
    "start": 528.0,
    "end": 529.0,
    "text": "只要有"
  },
  {
    "id": 229,
    "start": 529.0,
    "end": 531.0,
    "text": "天上有期待"
  },
  {
    "id": 230,
    "start": 531.0,
    "end": 532.0,
    "text": "有太多的自我"
  },
  {
    "id": 231,
    "start": 532.0,
    "end": 535.0,
    "text": "你就不能好好地自由地飛翔啊"
  },
  {
    "id": 232,
    "start": 535.0,
    "end": 536.0,
    "text": "所以"
  },
  {
    "id": 233,
    "start": 536.0,
    "end": 537.0,
    "text": "只有"
  },
  {
    "id": 234,
    "start": 537.0,
    "end": 539.0,
    "text": "消耀的思維"
  },
  {
    "id": 235,
    "start": 539.0,
    "end": 543.0,
    "text": "才是裝置所理想的"
  },
  {
    "id": 236,
    "start": 543.0,
    "end": 544.0,
    "text": "人生的思維"
  },
  {
    "id": 237,
    "start": 548.0,
    "end": 550.0,
    "text": "這一點呢"
  },
  {
    "id": 238,
    "start": 550.0,
    "end": 552.0,
    "text": "讓我指數"
  },
  {
    "id": 239,
    "start": 552.0,
    "end": 556.0,
    "text": "只要一個人能夠無待和無幾了"
  },
  {
    "id": 240,
    "start": 556.0,
    "end": 559.0,
    "text": "才能靠近真人"
  },
  {
    "id": 241,
    "start": 559.0,
    "end": 561.0,
    "text": "真正的真真人"
  },
  {
    "id": 242,
    "start": 561.0,
    "end": 563.0,
    "text": "我曾經想過"
  },
  {
    "id": 243,
    "start": 563.0,
    "end": 564.0,
    "text": "我說"
  },
  {
    "id": 244,
    "start": 564.0,
    "end": 567.0,
    "text": "辱家的目標是君子"
  },
  {
    "id": 245,
    "start": 567.0,
    "end": 570.0,
    "text": "佛家的目標是絕者"
  },
  {
    "id": 246,
    "start": 570.0,
    "end": 573.0,
    "text": "到家的目標是真人"
  },
  {
    "id": 247,
    "start": 573.0,
    "end": 575.0,
    "text": "這是他們不同的人個理想"
  },
  {
    "id": 248,
    "start": 575.0,
    "end": 577.0,
    "text": "真人這個觀念"
  },
  {
    "id": 249,
    "start": 577.0,
    "end": 580.0,
    "text": "儘管未經時期的名式也提出過"
  },
  {
    "id": 250,
    "start": 580.0,
    "end": 583.0,
    "text": "但是我認為最完整的"
  },
  {
    "id": 251,
    "start": 583.0,
    "end": 585.0,
    "text": "早期提出這個觀點"
  },
  {
    "id": 252,
    "start": 585.0,
    "end": 587.0,
    "text": "為未經名式提供約緣的"
  },
  {
    "id": 253,
    "start": 587.0,
    "end": 588.0,
    "text": "就是裝置"
  },
  {
    "id": 254,
    "start": 588.0,
    "end": 589.0,
    "text": "裝置"
  },
  {
    "id": 255,
    "start": 589.0,
    "end": 590.0,
    "text": "人生真的"
  },
  {
    "id": 256,
    "start": 590.0,
    "end": 592.0,
    "text": "說了真人是什麼"
  },
  {
    "id": 257,
    "start": 592.0,
    "end": 593.0,
    "text": "真是什麼"
  },
  {
    "id": 258,
    "start": 593.0,
    "end": 595.0,
    "text": "他的原文"
  },
  {
    "id": 259,
    "start": 595.0,
    "end": 597.0,
    "text": "他他不覺"
  },
  {
    "id": 260,
    "start": 597.0,
    "end": 598.0,
    "text": "其實也不太複雜了"
  },
  {
    "id": 261,
    "start": 598.0,
    "end": 600.0,
    "text": "他在大宗史裡邊說"
  },
  {
    "id": 262,
    "start": 600.0,
    "end": 602.0,
    "text": "何為真人"
  },
  {
    "id": 263,
    "start": 602.0,
    "end": 603.0,
    "text": "古子真人"
  },
  {
    "id": 264,
    "start": 603.0,
    "end": 604.0,
    "text": "乎逆寡"
  },
  {
    "id": 265,
    "start": 604.0,
    "end": 605.0,
    "text": "不雄城"
  },
  {
    "id": 266,
    "start": 605.0,
    "end": 606.0,
    "text": "不莫世"
  },
  {
    "id": 267,
    "start": 606.0,
    "end": 607.0,
    "text": "若然者"
  },
  {
    "id": 268,
    "start": 607.0,
    "end": 609.0,
    "text": "或乎毀"
  },
  {
    "id": 269,
    "start": 609.0,
    "end": 611.0,
    "text": "當而不自得也"
  },
  {
    "id": 270,
    "start": 611.0,
    "end": 612.0,
    "text": "若然者"
  },
  {
    "id": 271,
    "start": 612.0,
    "end": 614.0,
    "text": "真高不利"
  },
  {
    "id": 272,
    "start": 614.0,
    "end": 615.0,
    "text": "若水不如"
  },
  {
    "id": 273,
    "start": 615.0,
    "end": 616.0,
    "text": "若火不熱"
  },
  {
    "id": 274,
    "start": 616.0,
    "end": 619.0,
    "text": "是自自能"
  },
  {
    "id": 275,
    "start": 619.0,
    "end": 621.0,
    "text": "跟假與道者也弱此"
  },
  {
    "id": 276,
    "start": 621.0,
    "end": 623.0,
    "text": "這聽起來大家有一點惡口吧"
  },
  {
    "id": 277,
    "start": 623.0,
    "end": 624.0,
    "text": "我把它翻譯一下"
  },
  {
    "id": 278,
    "start": 624.0,
    "end": 626.0,
    "text": "我翻譯成當代的語句"
  },
  {
    "id": 279,
    "start": 626.0,
    "end": 628.0,
    "text": "這是我的特產"
  },
  {
    "id": 280,
    "start": 628.0,
    "end": 631.0,
    "text": "我總是要把古文儘量翻譯一下"
  },
  {
    "id": 281,
    "start": 631.0,
    "end": 633.0,
    "text": "我把我翻譯"
  },
  {
    "id": 282,
    "start": 633.0,
    "end": 634.0,
    "text": "裝置的這一段"
  },
  {
    "id": 283,
    "start": 634.0,
    "end": 636.0,
    "text": "有關真人"
  },
  {
    "id": 284,
    "start": 636.0,
    "end": 638.0,
    "text": "古代真人的論述"
  },
  {
    "id": 285,
    "start": 638.0,
    "end": 640.0,
    "text": "我給大家讓它翻譯一下"
  },
  {
    "id": 286,
    "start": 640.0,
    "end": 642.0,
    "text": "我這個翻譯"
  },
  {
    "id": 287,
    "start": 642.0,
    "end": 643.0,
    "text": "比較準確"
  },
  {
    "id": 288,
    "start": 643.0,
    "end": 645.0,
    "text": "每次每句都根據"
  },
  {
    "id": 289,
    "start": 645.0,
    "end": 647.0,
    "text": "學術上的言得要求來翻的"
  },
  {
    "id": 290,
    "start": 647.0,
    "end": 649.0,
    "text": "所以大家可以放心的聽"
  },
  {
    "id": 291,
    "start": 649.0,
    "end": 651.0,
    "text": "我是這麼翻譯的"
  },
  {
    "id": 292,
    "start": 651.0,
    "end": 652.0,
    "text": "這裝置的話"
  },
  {
    "id": 293,
    "start": 652.0,
    "end": 654.0,
    "text": "我用現代話來說"
  },
  {
    "id": 294,
    "start": 654.0,
    "end": 655.0,
    "text": "說"
  },
  {
    "id": 295,
    "start": 655.0,
    "end": 657.0,
    "text": "什麼是真人"
  },
  {
    "id": 296,
    "start": 657.0,
    "end": 658.0,
    "text": "古代的真人"
  },
  {
    "id": 297,
    "start": 658.0,
    "end": 660.0,
    "text": "不起落"
  },
  {
    "id": 298,
    "start": 660.0,
    "end": 661.0,
    "text": "不自雄"
  },
  {
    "id": 299,
    "start": 661.0,
    "end": 662.0,
    "text": "不寂寞"
  },
  {
    "id": 300,
    "start": 662.0,
    "end": 663.0,
    "text": "驚訝的人"
  },
  {
    "id": 301,
    "start": 663.0,
    "end": 665.0,
    "text": "失了不傲會"
  },
  {
    "id": 302,
    "start": 665.0,
    "end": 666.0,
    "text": "成了不自得"
  },
  {
    "id": 303,
    "start": 666.0,
    "end": 668.0,
    "text": "驚訝的人"
  },
  {
    "id": 304,
    "start": 668.0,
    "end": 669.0,
    "text": "增高"
  },
  {
    "id": 305,
    "start": 669.0,
    "end": 670.0,
    "text": "不暢倒"
  },
  {
    "id": 306,
    "start": 670.0,
    "end": 672.0,
    "text": "若水不成立"
  },
  {
    "id": 307,
    "start": 672.0,
    "end": 674.0,
    "text": "若火不覺得熱"
  },
  {
    "id": 308,
    "start": 675.0,
    "end": 679.0,
    "text": "只有見識和語道的人才能這樣"
  },
  {
    "id": 309,
    "start": 679.0,
    "end": 681.0,
    "text": "古代的真人"
  },
  {
    "id": 310,
    "start": 681.0,
    "end": 683.0,
    "text": "歲就無夢"
  },
  {
    "id": 311,
    "start": 683.0,
    "end": 684.0,
    "text": "醒來無饒"
  },
  {
    "id": 312,
    "start": 684.0,
    "end": 686.0,
    "text": "隱石不求香甜"
  },
  {
    "id": 313,
    "start": 686.0,
    "end": 689.0,
    "text": "呼吸又生又透"
  },
  {
    "id": 314,
    "start": 689.0,
    "end": 691.0,
    "text": "真人的呼吸"
  },
  {
    "id": 315,
    "start": 691.0,
    "end": 693.0,
    "text": "能夠貫通腳跟"
  },
  {
    "id": 316,
    "start": 693.0,
    "end": 695.0,
    "text": "而殘忍的呼吸"
  },
  {
    "id": 317,
    "start": 695.0,
    "end": 697.0,
    "text": "卻只在喉嚨"
  },
  {
    "id": 318,
    "start": 697.0,
    "end": 699.0,
    "text": "一個人如果屈服於他人"
  },
  {
    "id": 319,
    "start": 699.0,
    "end": 702.0,
    "text": "言語就會受足"
  },
  {
    "id": 320,
    "start": 702.0,
    "end": 703.0,
    "text": "那麼"
  },
  {
    "id": 321,
    "start": 703.0,
    "end": 705.0,
    "text": "如果屈服於慾望"
  },
  {
    "id": 322,
    "start": 705.0,
    "end": 708.0,
    "text": "天人的更細也就錢了"
  },
  {
    "id": 323,
    "start": 709.0,
    "end": 711.0,
    "text": "古代的真人"
  },
  {
    "id": 324,
    "start": 711.0,
    "end": 712.0,
    "text": "不太臉身"
  },
  {
    "id": 325,
    "start": 712.0,
    "end": 714.0,
    "text": "不厭惡死惡"
  },
  {
    "id": 326,
    "start": 714.0,
    "end": 716.0,
    "text": "對於出身"
  },
  {
    "id": 327,
    "start": 716.0,
    "end": 717.0,
    "text": "並不心喜"
  },
  {
    "id": 328,
    "start": 717.0,
    "end": 720.0,
    "text": "對於死亡也不拒絕"
  },
  {
    "id": 329,
    "start": 720.0,
    "end": 722.0,
    "text": "自由自在的去"
  },
  {
    "id": 330,
    "start": 722.0,
    "end": 724.0,
    "text": "就像自由自在的來"
  },
  {
    "id": 331,
    "start": 724.0,
    "end": 726.0,
    "text": "不忘記起點"
  },
  {
    "id": 332,
    "start": 726.0,
    "end": 728.0,
    "text": "不追求終點"
  },
  {
    "id": 333,
    "start": 728.0,
    "end": 729.0,
    "text": "事情來了"
  },
  {
    "id": 334,
    "start": 729.0,
    "end": 731.0,
    "text": "就心染結晝"
  },
  {
    "id": 335,
    "start": 731.0,
    "end": 732.0,
    "text": "如果忘了"
  },
  {
    "id": 336,
    "start": 732.0,
    "end": 734.0,
    "text": "有恢復自然"
  },
  {
    "id": 337,
    "start": 734.0,
    "end": 735.0,
    "text": "這就是說"
  },
  {
    "id": 338,
    "start": 735.0,
    "end": 738.0,
    "text": "不用人心去守開大道"
  },
  {
    "id": 339,
    "start": 738.0,
    "end": 739.0,
    "text": "不用人力"
  },
  {
    "id": 340,
    "start": 739.0,
    "end": 742.0,
    "text": "去加主天然"
  },
  {
    "id": 341,
    "start": 742.0,
    "end": 745.0,
    "text": "這才是稱得上真人"
  },
  {
    "id": 342,
    "start": 745.0,
    "end": 748.0,
    "text": "這是我對裝飾的翻譯"
  },
  {
    "id": 343,
    "start": 748.0,
    "end": 749.0,
    "text": "我下次再見"
  }
]