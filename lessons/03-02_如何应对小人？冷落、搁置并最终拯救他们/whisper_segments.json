  },
  {
    "id": 277,
    "start": 801.0,
    "end": 802.0,
    "text": "其實不少"
  },
  {
    "id": 278,
    "start": 802.0,
    "end": 804.0,
    "text": "但是"
  },
  {
    "id": 279,
    "start": 804.0,
    "end": 806.0,
    "text": "仍然"
  },
  {
    "id": 280,
    "start": 806.0,
    "end": 809.0,
    "text": "會被好多小人包圍著"
  },
  {
    "id": 281,
    "start": 809.0,
    "end": 811.0,
    "text": "中國民眾雖然"
  },
  {
    "id": 282,
    "start": 811.0,
    "end": 813.0,
    "text": "也已經驗返小人了"
  },
  {
    "id": 283,
    "start": 813.0,
    "end": 814.0,
    "text": "但是"
  },
  {
    "id": 284,
    "start": 814.0,
    "end": 815.0,
    "text": "一望很多年"
  },
  {
    "id": 285,
    "start": 815.0,
    "end": 818.0,
    "text": "被小人策來策去的視線"
  },
  {
    "id": 286,
    "start": 818.0,
    "end": 820.0,
    "text": "還沒有恢復到"
  },
  {
    "id": 287,
    "start": 820.0,
    "end": 823.0,
    "text": "來養望精神文化的功能"
  },
  {
    "id": 288,
    "start": 823.0,
    "end": 824.0,
    "text": "結果"
  },
  {
    "id": 289,
    "start": 824.0,
    "end": 826.0,
    "text": "雖然小人被冷落了"
  },
  {
    "id": 290,
    "start": 826.0,
    "end": 829.0,
    "text": "精神文化最重高的部位"
  },
  {
    "id": 291,
    "start": 829.0,
    "end": 831.0,
    "text": "也被冷落著"
  },
  {
    "id": 292,
    "start": 831.0,
    "end": 833.0,
    "text": "這是一個"
  },
  {
    "id": 293,
    "start": 833.0,
    "end": 835.0,
    "text": "雙下冷落的過程"
  },
  {
    "id": 294,
    "start": 835.0,
    "end": 836.0,
    "text": "我相信"
  },
  {
    "id": 295,
    "start": 836.0,
    "end": 838.0,
    "text": "這個雙下冷落過程"
  },
  {
    "id": 296,
    "start": 838.0,
    "end": 840.0,
    "text": "是一個暫時的過程"
  },
  {
    "id": 297,
    "start": 843.0,
    "end": 845.0,
    "text": "最後我必須補充一點"
  },
  {
    "id": 298,
    "start": 845.0,
    "end": 847.0,
    "text": "經過小人在整體上"
  },
  {
    "id": 299,
    "start": 847.0,
    "end": 849.0,
    "text": "獲害久遠"
  },
  {
    "id": 300,
    "start": 849.0,
    "end": 850.0,
    "text": "但是"
  },
  {
    "id": 301,
    "start": 850.0,
    "end": 852.0,
    "text": "他們的個體生命"
  },
  {
    "id": 302,
    "start": 853.0,
    "end": 855.0,
    "text": "如果來看一看的話"
  },
  {
    "id": 303,
    "start": 855.0,
    "end": 857.0,
    "text": "多數也是可憐人"
  },
  {
    "id": 304,
    "start": 857.0,
    "end": 858.0,
    "text": "包括其中"
  },
  {
    "id": 305,
    "start": 858.0,
    "end": 861.0,
    "text": "最靈人驗返的文皮性小人"
  },
  {
    "id": 306,
    "start": 861.0,
    "end": 862.0,
    "text": "其實"
  },
  {
    "id": 307,
    "start": 862.0,
    "end": 863.0,
    "text": "也就是一些"
  },
  {
    "id": 308,
    "start": 863.0,
    "end": 867.0,
    "text": "喝了狼奶的失敗者和憂鬱者"
  },
  {
    "id": 309,
    "start": 867.0,
    "end": 868.0,
    "text": "他們"
  },
  {
    "id": 310,
    "start": 868.0,
    "end": 869.0,
    "text": "在我看來"
  },
  {
    "id": 311,
    "start": 869.0,
    "end": 872.0,
    "text": "還是有被拯救的可能"
  },
  {
    "id": 312,
    "start": 872.0,
    "end": 873.0,
    "text": "冷落他們"
  },
  {
    "id": 313,
    "start": 873.0,
    "end": 874.0,
    "text": "隔止他們"
  },
  {
    "id": 314,
    "start": 874.0,
    "end": 876.0,
    "text": "然後拯救他們"
  },
  {
    "id": 315,
    "start": 876.0,
    "end": 877.0,
    "text": "這是"
  },
  {
    "id": 316,
    "start": 877.0,
    "end": 880.0,
    "text": "當代君子的責任"
  },
  {
    "id": 317,
    "start": 880.0,
    "end": 882.0,
    "text": "蘇道底"
  },
  {
    "id": 318,
    "start": 882.0,
    "end": 883.0,
    "text": "他們"
  },
  {
    "id": 319,
    "start": 883.0,
    "end": 884.0,
    "text": "是在一個"
  },
  {
    "id": 320,
    "start": 884.0,
    "end": 887.0,
    "text": "削燒怪的環境裡面長大的一群"
  },
  {
    "id": 321,
    "start": 887.0,
    "end": 890.0,
    "text": "因此也應該是有到關愛"
  },
  {
    "id": 322,
    "start": 890.0,
    "end": 892.0,
    "text": "我們比試的"
  },
  {
    "id": 323,
    "start": 892.0,
    "end": 895.0,
    "text": "是他們以往的作方式"
  },
  {
    "id": 324,
    "start": 895.0,
    "end": 896.0,
    "text": "以及他們在歷史上"
  },
  {
    "id": 325,
    "start": 896.0,
    "end": 899.0,
    "text": "曾經有過的結合狀態"
  },
  {
    "id": 326,
    "start": 899.0,
    "end": 901.0,
    "text": "我們"
  },
  {
    "id": 327,
    "start": 901.0,
    "end": 902.0,
    "text": "除了"
  },
  {
    "id": 328,
    "start": 902.0,
    "end": 903.0,
    "text": "揭露他們"
  },
  {
    "id": 329,
    "start": 903.0,
    "end": 904.0,
    "text": "冷落他們"
  },
  {
    "id": 330,
    "start": 904.0,
    "end": 906.0,
    "text": "比試他們隔止他們"
  },
  {
    "id": 331,
    "start": 906.0,
    "end": 907.0,
    "text": "最後"
  },
  {
    "id": 332,
    "start": 907.0,
    "end": 909.0,
    "text": "是拯救他們"
  },
  {
    "id": 333,
    "start": 909.0,
    "end": 910.0,
    "text": "萬愛他們"
  },
  {
    "id": 334,
    "start": 910.0,
    "end": 911.0,
    "text": "謝謝"
  }
]