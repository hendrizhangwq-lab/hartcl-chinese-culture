    "id": 273,
    "start": 795.0,
    "end": 796.0,
    "text": "我們的時代"
  },
  {
    "id": 274,
    "start": 796.0,
    "end": 798.0,
    "text": "與偉大現在還有距離"
  },
  {
    "id": 275,
    "start": 798.0,
